# Build artifacts
/target/

# Reports are run output: local evidence, never committed. Captures of a real
# network in particular are not ours to publish.
/reports/
*.pcap
*.pcapng
*.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Scratch / temp
/temp/
/tmp/
/output/

# Harness fixtures are committed on purpose: parsers are tested against real
# captured tool output, not assumed formats. Overrides the *.json rule above.
!/harness/fixtures/**
__pycache__/
